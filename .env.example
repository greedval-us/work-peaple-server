# Server runtime: greed@192.168.0.102, /home/greed/apps/work-people-server.
# Copy to .env on that host only; never commit .env or overwrite an existing one.
NODE_ENV=development
GRPC_HOST=127.0.0.1
GRPC_PORT=50051
HEALTHCHECK_TIMEOUT_MS=3000
AUTH_SESSION_TTL_SECONDS=43200
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_WINDOW_SECONDS=300

# Use unique URL-safe passwords (letters, digits, - and _) before deployment.
# Keep credentials in these URLs in sync with the variables below.
POSTGRES_USER=workpeople
POSTGRES_DB=workpeople
POSTGRES_PASSWORD=change_me_postgres_password
REDIS_PASSWORD=change_me_redis_password
DATABASE_URL=postgresql://workpeople:change_me_postgres_password@127.0.0.1:5432/workpeople
REDIS_URL=redis://:change_me_redis_password@127.0.0.1:6379/0

# Compose publishes only gRPC, on loopback by default.
GRPC_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5432
REDIS_PORT=6379

# Remote access: enable TLS or use an encrypted private tunnel.
# In Compose ./certs is mounted read-only at /app/certs.
GRPC_TLS_ENABLED=false
GRPC_TLS_CERT_PATH=./certs/server.crt
GRPC_TLS_KEY_PATH=./certs/server.key
# Custom CA is optional. Empty means system trust roots.
GRPC_TLS_CA_PATH=
# If the cert uses a deployment DNS name, use that name for the loopback probe.
GRPC_TLS_SERVER_NAME=
